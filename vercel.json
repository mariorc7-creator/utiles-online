{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-static.cjs",
  "outputDirectory": "_site",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "papelesdelbebe\\.es"
        }
      ],
      "destination": "https://www.papelesdelbebe.es/:path*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/analytics.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/global-ui.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
