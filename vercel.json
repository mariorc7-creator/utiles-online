{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "papelesdelbebe\\.es"
        }
      ],
      "destination": "https://www.papelesdelbebe.es/:path*",
      "statusCode": 301
    }
  ]
}
